# Copy to .env.local for local development. Never commit a real .env file —
# .gitignore already excludes .env* except this example.

# The app's runtime connection — the app_runtime role's transaction-pooler
# string (see docs/architecture/staging-environment-setup.md). Must be the
# restricted role, never the project's default postgres role.
DATABASE_URL=postgresql://app_runtime.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Elevated role for running migrations only (npm run db:migrate). Only
# needed locally / in CI's migration step — the deployed app never needs
# this. Falls back to DATABASE_URL if unset, but that will fail against
# app_runtime, which intentionally has no DDL privileges.
MIGRATIONS_DATABASE_URL=

# Email delivery (docs/architecture/email-delivery-setup.md). Read by the
# WORKER (npm run worker:tick), which is what sends email. Unset = emails are
# recorded and held, never sent. Even when set, nothing is sent until the
# 'vendor.email' gate is approved (signed DPA), and client emails also wait
# for attorney-approved wording.
EMAIL_PROVIDER=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=
POSTMARK_MESSAGE_STREAM=outbound

# Postmark delivery/bounce webhook (POST /api/webhooks/postmark). Read by the
# WEB APP. Both must be set or every webhook call is refused.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Client portal (c11, c112 — docs/product/features/all-engines/client-portal.md).
# Signs client portal session cookies. Separate from staff auth. At least 32
# random characters (e.g. `openssl rand -base64 48`). Unset = the portal is
# switched off (fails closed). Rotating it signs every client out.
CLIENT_SESSION_SECRET=
# Public https origin of this app, e.g. https://app.example.com (no path).
# Used to build the emailed sign-in link and {portalUrl} in client emails —
# never taken from the request's Host header. Unset = sign-in emails are held.
# Set on the web service AND the worker. The web service also needs the
# EMAIL_PROVIDER / POSTMARK_SERVER_TOKEN / EMAIL_FROM_ADDRESS values above,
# because it sends the sign-in email itself.
PORTAL_BASE_URL=
